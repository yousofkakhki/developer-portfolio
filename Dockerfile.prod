FROM node:20 AS build

WORKDIR /app
# Puppeteer is a development-only dependency used by local checks. Production
# images do not need its browser download during npm ci.
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM node:20-alpine AS release

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node:node --from=build /app/.next ./.next
COPY --chown=node:node --from=build /app/public ./public
COPY --chown=node:node --from=build /app/app ./app
COPY --chown=node:node --from=build /app/messages ./messages
COPY --chown=node:node --from=build /app/utils ./utils
COPY --chown=node:node --from=build /app/next.config.js ./next.config.js
COPY --chown=node:node --from=build /app/i18n.js ./i18n.js
COPY --chown=node:node --from=build /app/middleware.js ./middleware.js
COPY --chown=node:node --from=build /app/middleware-security.js ./middleware-security.js
COPY --chown=node:node --from=build /app/jsconfig.json ./jsconfig.json

RUN mkdir -p /app/data/analytics /app/.next/cache && \
    chown -R node:node /app/data /app/.next/cache
USER node

EXPOSE 3000
CMD ["npm", "start"]
