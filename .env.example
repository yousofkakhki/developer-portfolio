# Canonical public origin
NEXT_PUBLIC_APP_URL=https://kakhki.me

# Webmaster verification tokens. Leave blank until issued by the service.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-side revalidation secret. Generate a strong random value.
REVALIDATE_SECRET=

# Optional analytics storage override. The production compose file persists this path.
ANALYTICS_DIR=/app/data/analytics

# Contact delivery. Configure at least SMTP or Telegram; never commit real values.
# For the production Mailcow internal relay only: use postfix-mailcow:25, set a valid
# local sender/recipient, and set SMTP_AUTH_DISABLED=true. This mode is rejected for
# every other SMTP host or port.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH_DISABLED=false
RECEIVING_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
